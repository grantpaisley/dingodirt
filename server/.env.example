# Database
DATABASE_URL=postgres://dingo:dingo@localhost:5433/dingo

# Dingo Configuration
DINGO_LOG_LEVEL=info
DINGO_FILE_STORE_PATH=./files
# The browsable GPX library tree (same root `dingo organize --dest` targets).
# The daemon places imported tracks here immediately after clean+name.
DINGO_LIBRARY_PATH=./library
DINGO_PHOTO_STORE_PATH=./photos
DINGO_MODEL_PATH=./models

# External APIs (optional)
OPEN_METEO_API_URL=https://archive-api.open-meteo.com/v1/archive
ANTHROPIC_API_KEY=

# Google OAuth (for Photos integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Strava global heatmap overlay (server-side session login → CloudFront tile cookies).
# Personal strava.com credentials; used only to harvest heatmap tile cookies. Optional.
STRAVA_EMAIL=
STRAVA_PASSWORD=

# Source PMTiles basemap (topo/vector) for .dingonav corridor extracts
# (optional). A local file or an http(s) URL — the global Protomaps daily
# build makes extracts work anywhere; a local area extract only covers its own
# bounds (corridors outside it get an "outside coverage" note instead of
# tiles). Protomaps keeps only ~a week of daily builds, so ANY
# build.protomaps.com URL is re-resolved to the newest one that answers — the
# date below is a placeholder, not a pin.
DINGO_BASEMAP_PMTILES=https://build.protomaps.com/latest.pmtiles
# Source terrarium-DEM PMTiles for the "Hillshade" export layer (optional;
# file or URL, same coverage rules as above). Cut a local extract with
# DingoNav's make_hillshade.py (AWS terrain tiles, free, no key), e.g.
#   make_hillshade.py --bbox 149.5,-34.6,151.95,-32.6 -o hillshade.pmtiles
# Publishing hard-fails with an "outside the source's coverage" error when a
# pack's corridor falls outside the extract — re-cut a wider bbox and retry.
DINGO_HILLSHADE_PMTILES=
# GitHub repo (owner/name) that hosts share-link bundles carrying map tiles.
# The .dingonav zip is committed here via the `gh` CLI and served from
# raw.githubusercontent.com (CORS-enabled; Release assets are NOT). Use an
# initialized public repo you own, e.g. grantpaisley/dingo-shares. Needed for
# "Share link" with any map layer ticked (gists are text-only). Optional.
DINGO_SHARE_REPO=
# Path to a local clone of DINGO_SHARE_REPO. When set, pack publishes commit
# and push the bundle through git instead of the contents API — the API caps
# out around 40 MB of file, git takes 100 MB. Optional but recommended once
# packs carry map layers.
#DINGO_SHARE_CLONE=/path/to/dingo-shares
# Base URL of the DingoNav PWA that share links open (optional; defaults to the
# hosted GitHub Pages build).
#DINGO_NAV_URL=https://grantpaisley.github.io/DingoNav/

# Heat harvester (dingo-harvest). Cookies: raw Cookie header value from a
# logged-in browser's heat-tile request (falls back to the strava_heatmap_cookies
# table pasted via the web UI). URL override is for tests/other sports.
STRAVA_HEAT_COOKIES=
#DINGO_HEAT_URL=https://content-a.strava.com/identified/globalheat/sport_Ride/grayscale/{z}/{x}/{y}.png

# Google Routes API key — powers the Google Maps URL import (paste a
# maps.app.goo.gl directions link in Plan's Import dialog). Create a Google
# Cloud API key with the Routes API enabled; restrict it to that API.
# Remember the daemon does not read .env — pass this in its environment.
GOOGLE_MAPS_API_KEY=
