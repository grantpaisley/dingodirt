{
  "name": "Dingo default",
  "author": "Dingo Studio built-ins",
  "version": 1,
  "schemaVersion": "1.0",
  "params": {
    "guidance.mode": "track",
    "guidance.cueSource": "marks",
    "guidance.strictOrder": false,
    "guidance.laneGuidance": false,
    "guidance.stackCues": false,
    "guidance.waypointAdvance": "auto",
    "camera.followMode": "courseUp",
    "camera.pauseOnGesture": true,
    "camera.pitch": 0,
    "camera.autoZoom": true,
    "camera.zoomMode": "cruise",
    "camera.zoomCurve": [
      [
        0,
        300
      ],
      [
        30,
        900
      ],
      [
        70,
        2500
      ]
    ],
    "camera.maxZoom": 18,
    "camera.approachZoom": true,
    "camera.approachSecs": 15,
    "camera.approachMul": 1.5,
    "camera.approachFloorM": 250,
    "camera.lookAhead": 0.15,
    "camera.easeMs": 900,
    "camera.overviewWindowMin": 0,
    "position.snapToRoute": false,
    "position.marker": "dart",
    "position.breadcrumb": true,
    "position.breadcrumbSpacingM": 20,
    "offroute.detectM": 60,
    "offroute.rejoinM": 40,
    "offroute.alert": "beep",
    "offroute.repeatSecs": 30,
    "offroute.banner": true,
    "offroute.guideLine": false,
    "offroute.maxDeviationM": 0,
    "reroute.mode": "none",
    "reroute.triggerM": 100,
    "reroute.retrySecs": 30,
    "reroute.confirm": false,
    "cues.farSecs": 15,
    "cues.farMinM": 60,
    "cues.farMaxM": 250,
    "cues.nearSecs": 5,
    "cues.nearMinM": 25,
    "cues.nearMaxM": 70,
    "cues.dangerFarM": 200,
    "cues.dangerNearM": 50,
    "cues.confirmAfterM": 30,
    "voice.mode": "beeps",
    "voice.density": "medium",
    "voice.streetNames": false,
    "hud.speedo": true,
    "hud.speedLimit": false,
    "hud.speedAlert": "none",
    "hud.speedAlertKmh": 8,
    "hud.nextTurnPanel": "full",
    "hud.etaPanel": false,
    "hud.units": "metric",
    "hud.nightAuto": false
