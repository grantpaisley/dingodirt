{
  "name": "DingoNav",
  "short_name": "DingoNav",
  "description": "Offline GPX track follower with turn beeps, heatmap and offline basemap",
  "start_url": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0e1216",
  "theme_color": "#0e1216",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "share",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/gpx+xml", "application/xml", "text/xml", ".gpx",
            "application/geo+json", "application/json", ".geojson",
            "application/x-dingonav", ".dingonav",
            "application/zip", ".zip",
            "application/octet-stream"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-dingonav": [".dingonav"],
        "application/zip": [".dingonav", ".zip"]
      }
    },
    {
      "action": "./",
      "accept": {
        "application/gpx+xml": [".gpx"],
        "application/geo+json": [".geojson"]
      }
    }
  ]
}
